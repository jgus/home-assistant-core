  "services": {
    "restore_settings": {
      "description": "Restores the receiver's settings from its secure backup slot.",
      "fields": {
        "pin": {
          "description": "Installer PIN, 4 digits. Defaults to 1234 if omitted.",
          "name": "[%key:component::arcam_fmj::services::save_settings::fields::pin::name%]"
        }
      },
      "name": "Restore settings"
    },
    "save_settings": {
      "description": "Saves the receiver's current settings to its secure backup slot.",
      "fields": {
        "pin": {
          "description": "Installer PIN, 4 digits. Defaults to 1234 if omitted.",
          "name": "PIN"
        }
      },
      "name": "Save settings"
    }
